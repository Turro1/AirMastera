@model LoginViewModel

<head>
    <link href=@Url.Content("~/styles/app.css") rel="stylesheet" type="text/css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            margin: 0;
            color: #333;
        }
        
        .form-container {
            background: #fff;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            width: 360px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, #4361ee, #a991ff, #00b4d8);
        }
        
        .header {
            font-size: 28px;
            margin-bottom: 30px;
            font-weight: 600;
            color: #4361ee;
            position: relative;
            padding-bottom: 12px;
        }
        
        .header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 3px;
            background-color: #4361ee;
        }
        
        .intro-text {
            font-size: 14px;
            margin-bottom: 25px;
            color: #666;
            line-height: 1.5;
        }
        
        .block {
            margin-bottom: 20px;
            text-align: left;
            position: relative;
        }
        
        label {
            display: block;
            font-weight: 500;
            margin-bottom: 8px;
            font-size: 14px;
            transition: all 0.3s ease;
        }
        
        .input-wrapper {
            position: relative;
        }
        
        .input {
            width: 100%;
            padding: 12px 15px;
            padding-left: 40px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 15px;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }
        
        .input:focus {
            border-color: #4361ee;
            outline: none;
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.2);
        }
        
        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            transition: all 0.3s ease;
        }
        
        .input:focus + .input-icon {
            color: #4361ee;
        }
        
        .remember-me {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            font-size: 14px;
        }
        
        .remember-me input {
            margin-right: 8px;
        }
        
        .button {
            background: #4361ee;
            color: white;
            padding: 14px;
            border: none;
            border-radius: 8px;
            width: 100%;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .button:hover {
            background: #3a56d4;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(67, 97, 238, 0.3);
        }
        
        .button:active {
            transform: translateY(1px);
        }
        
        .form-footer {
            margin-top: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }
        
        .switch-button {
            display: flex;
            align-items: center;
            color: #4361ee;
            text-decoration: none;
            font-weight: 500;
            font-size: 15px;
            transition: all 0.3s ease;
        }
        
        .switch-button i {
            margin-left: 5px;
        }
        
        .switch-button:hover {
            color: #3a56d4;
        }
        
        .forgot-password {
            color: #666;
            font-size: 14px;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .forgot-password:hover {
            color: #4361ee;
            text-decoration: underline;
        }
        
        .input-tooltip {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            cursor: help;
        }
        
        .input-tooltip:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            right: 0;
            top: -40px;
            background: #333;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 12px;
            white-space: nowrap;
        }
        
        .validation-message {
            color: #e63946;
            font-size: 12px;
            margin-top: 5px;
            display: none;
        }

    </style>
</head>
<body>
    <div class="form-container">
        <form asp-controller="Auth" asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl">
            <div class="header">Вход в систему</div>
            <p class="intro-text">Добро пожаловать! Пожалуйста, введите свои учетные данные для доступа к вашему аккаунту.</p>
            
            <div class="block">
                <label for="Username">Имя пользователя</label>
                <div class="input-wrapper">
                    <input asp-for="Username" class="input" placeholder="Введите имя пользователя"/>
                    <i class="fas fa-user input-icon"></i>
                    <i class="fas fa-info-circle input-tooltip" data-tooltip="Используйте ваше зарегистрированное имя пользователя"></i>
                </div>
                <span class="validation-message" id="username-validation">Пожалуйста, введите имя пользователя</span>
            </div>
            
            <div class="block">
                <label for="Password">Пароль</label>
                <div class="input-wrapper">
                    <input asp-for="Password" class="input" type="password" placeholder="Введите пароль"/>
                    <i class="fas fa-lock input-icon"></i>
                    <i class="fas fa-eye input-tooltip" id="toggle-password" data-tooltip="Показать пароль"></i>
                </div>
                <span class="validation-message" id="password-validation">Пожалуйста, введите пароль</span>
            </div>
            
            <div class="remember-me">
                <input type="checkbox" id="remember" name="remember">
                <label for="remember" style="display: inline;">Запомнить меня</label>
            </div>
            
            <div>
                <button type="submit" class="button">
                    <i class="fas fa-sign-in-alt" style="margin-right: 8px;"></i>Войти
                </button>
            </div>
            
            <div class="form-footer">
                <a href="#" class="forgot-password">Забыли пароль?</a>
                <a asp-controller="Auth" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="switch-button">
                    Регистрация <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </form>
    </div>
    
    <script>
        // Toggle password visibility
        document.getElementById('toggle-password').addEventListener('click', function() {
            const passwordInput = document.querySelector('input[type="password"]');
            const icon = this;
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
                icon.setAttribute('data-tooltip', 'Скрыть пароль');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
                icon.setAttribute('data-tooltip', 'Показать пароль');
            }
        });
        
        // Simple form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            let isValid = true;
            const username = document.getElementById('Username');
            const password = document.getElementById('Password');
            const usernameValidation = document.getElementById('username-validation');
            const passwordValidation = document.getElementById('password-validation');
            
            if (!username.value.trim()) {
                usernameValidation.style.display = 'block';
                username.style.borderColor = '#e63946';
                isValid = false;
            } else {
                usernameValidation.style.display = 'none';
                username.style.borderColor = '#e0e0e0';
            }
            
            if (!password.value.trim()) {
                passwordValidation.style.display = 'block';
                password.style.borderColor = '#e63946';
                isValid = false;
            } else {
                passwordValidation.style.display = 'none';
                password.style.borderColor = '#e0e0e0';
            }
            
            if (!isValid) {
                e.preventDefault();
            }
        });
    </script>
</body>