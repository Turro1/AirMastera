@model RegisterViewModel

<head>
    <link href=@Url.Content("~/styles/app.css") rel="stylesheet" type="text/css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            margin: 0;
            color: #333;
        }
        
        .form-container {
            background: #fff;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            width: 360px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, #28a745, #20c997, #17a2b8);
        }
        
        .header {
            font-size: 28px;
            margin-bottom: 30px;
            font-weight: 600;
            color: #28a745;
            position: relative;
            padding-bottom: 12px;
        }
        
        .header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 3px;
            background-color: #28a745;
        }
        
        .intro-text {
            font-size: 14px;
            margin-bottom: 25px;
            color: #666;
            line-height: 1.5;
        }
        
        .block {
            margin-bottom: 20px;
            text-align: left;
            position: relative;
        }
        
        label {
            display: block;
            font-weight: 500;
            margin-bottom: 8px;
            font-size: 14px;
            transition: all 0.3s ease;
        }
        
        .input-wrapper {
            position: relative;
        }
        
        .input {
            width: 100%;
            padding: 12px 15px;
            padding-left: 40px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 15px;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }
        
        .input:focus {
            border-color: #28a745;
            outline: none;
            box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.2);
        }
        
        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            transition: all 0.3s ease;
        }
        
        .input:focus + .input-icon {
            color: #28a745;
        }
        
        .password-strength {
            height: 5px;
            background-color: #eee;
            margin-top: 8px;
            border-radius: 3px;
            overflow: hidden;
        }
        
        .password-strength-meter {
            height: 100%;
            width: 0%;
            transition: all 0.3s ease;
        }
        
        .password-feedback {
            font-size: 12px;
            margin-top: 5px;
            color: #666;
        }
        
        .button {
            background: #28a745;
            color: white;
            padding: 14px;
            border: none;
            border-radius: 8px;
            width: 100%;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .button:hover {
            background: #218838;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
        }
        
        .button:active {
            transform: translateY(1px);
        }
        
        .form-footer {
            margin-top: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }
        
        .switch-button {
            display: flex;
            align-items: center;
            color: #007bff;
            text-decoration: none;
            font-weight: 500;
            font-size: 15px;
            transition: all 0.3s ease;
            margin: 20px auto 0;
        }
        
        .switch-button i {
            margin-left: 5px;
        }
        
        .switch-button:hover {
            color: #0056b3;
        }
        
        .input-tooltip {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            cursor: help;
        }
        
        .input-tooltip:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            right: 0;
            top: -40px;
            background: #333;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 12px;
            white-space: nowrap;
            z-index: 10;
        }
        
        span[asp-validation-for] {
            color: #dc3545;
            font-size: 12px;
            margin-top: 5px;
            display: block;
        }
        
        .privacy-policy {
            font-size: 12px;
            color: #666;
            margin-top: 15px;
            text-align: center;
        }
        
        .privacy-policy a {
            color: #007bff;
            text-decoration: none;
        }
        
        .privacy-policy a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="form-container">
        <form asp-controller="Auth" asp-action="Register" method="post">
            <input type="hidden" asp-for="ReturnUrl"/>
            <div class="header">Регистрация</div>
            <p class="intro-text">Создайте аккаунт, чтобы получить доступ ко всем функциям нашего сервиса</p>
            
            <div class="block">
                <label for="Username">Имя пользователя</label>
                <div class="input-wrapper">
                    <input asp-for="Username" class="input" placeholder="Выберите имя пользователя"/>
                    <i class="fas fa-user input-icon"></i>
                    <i class="fas fa-info-circle input-tooltip" data-tooltip="Имя пользователя будет отображаться в вашем профиле"></i>
                </div>
                <span asp-validation-for="Username"></span>
            </div>
            
            <div class="block">
                <label for="Password">Пароль</label>
                <div class="input-wrapper">
                    <input asp-for="Password" class="input" type="password" placeholder="Создайте надежный пароль" id="password"/>
                    <i class="fas fa-lock input-icon"></i>
                    <i class="fas fa-eye input-tooltip" id="toggle-password" data-tooltip="Показать пароль"></i>
                </div>
                <div class="password-strength">
                    <div class="password-strength-meter" id="password-meter"></div>
                </div>
                <p class="password-feedback" id="password-feedback">Используйте не менее 8 символов, включая буквы и цифры</p>
                <span asp-validation-for="Password"></span>
            </div>
            
            <div class="block">
                <label for="ConfirmPassword">Подтверждение пароля</label>
                <div class="input-wrapper">
                    <input asp-for="ConfirmPassword" class="input" type="password" placeholder="Повторите пароль"/>
                    <i class="fas fa-lock input-icon"></i>
                </div>
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
            
            <div>
                <button type="submit" class="button">
                    <i class="fas fa-user-plus" style="margin-right: 8px;"></i>Зарегистрироваться
                </button>
            </div>
            
            <p class="privacy-policy">
                Регистрируясь, вы соглашаетесь с нашими <a href="#">Условиями использования</a> и <a href="#">Политикой конфиденциальности</a>
            </p>
            
            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="switch-button">
                <i class="fas fa-sign-in-alt" style="margin-right: 8px;"></i>Уже есть аккаунт? Войти
            </a>
        </form>
    </div>
    
    <script>
        // Toggle password visibility
        document.getElementById('toggle-password').addEventListener('click', function() {
            const passwordInput = document.querySelector('input[type="password"]');
            const icon = this;
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
                icon.setAttribute('data-tooltip', 'Скрыть пароль');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
                icon.setAttribute('data-tooltip', 'Показать пароль');
            }
        });
        
        // Password strength meter
        document.getElementById('password').addEventListener('input', function() {
            const password = this.value;
            const meter = document.getElementById('password-meter');
            const feedback = document.getElementById('password-feedback');
            
            // Simple password strength calculation
            let strength = 0;
            
            if (password.length >= 8) strength += 25;
            if (password.match(/[A-Z]/)) strength += 25;
            if (password.match(/[0-9]/)) strength += 25;
            if (password.match(/[^A-Za-z0-9]/)) strength += 25;
            
            // Update meter and feedback
            meter.style.width = strength + '%';
            
            if (strength <= 25) {
                meter.style.backgroundColor = '#dc3545';
                feedback.textContent = 'Слабый пароль';
                feedback.style.color = '#dc3545';
            } else if (strength <= 50) {
                meter.style.backgroundColor = '#ffc107';
                feedback.textContent = 'Средний пароль';
                feedback.style.color = '#ffc107';
            } else if (strength <= 75) {
                meter.style.backgroundColor = '#17a2b8';
                feedback.textContent = 'Хороший пароль';
                feedback.style.color = '#17a2b8';
            } else {
                meter.style.backgroundColor = '#28a745';
                feedback.textContent = 'Отличный пароль!';
                feedback.style.color = '#28a745';
            }
            
            if (password.length === 0) {
                feedback.textContent = 'Используйте не менее 8 символов, включая буквы и цифры';
                feedback.style.color = '#666';
                meter.style.width = '0%';
            }
        });
    </script>
</body>